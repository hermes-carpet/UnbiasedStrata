# Build target profile. Written by .github/scripts/scrape-target.sh on the target box;
# this one is a SEED from what is known by hand -- rerun the scraper on the 3090 box to
# replace it (it fills in the real CPU flags).
TARGET_NAME='3090-debian13'
SCRAPED='seed (hand-written, not scraped)'
IMAGE='debian:13'
CUDA_SOURCE='debian-apt'
CUDA_VERSION='12.4.131'
CUDA_ARCHS='86-real'
HOST_GCC='13'
GPUS='NVIDIA GeForce RTX 3090 (sm_86)'
GLIBC='2.41'
CPU_MARCH='x86-64-v3'
CPU_FLAGS=''
