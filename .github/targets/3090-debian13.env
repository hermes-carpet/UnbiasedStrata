# Build target profile. Hand-written (CUDA moved to NVIDIA's repo, 13.5); rerun
# .github/scripts/scrape-target.sh on the 3090 box to replace it with a scraped one.
TARGET_NAME='3090-debian13'
SCRAPED='hand-written, not scraped'
IMAGE='debian:13'
CUDA_SOURCE='nvidia-repo'
CUDA_VERSION='13.5'
CUDA_ON_TARGET='yes'
CUDA_ARCHS='86-real'
HOST_GCC='14'
GPUS='NVIDIA GeForce RTX 3090 (sm_86)'
GLIBC='2.41'
CPU_MODE='ggml'
CPU_MARCH='x86-64-v4'
CPU_FLAGS='-march=x86-64-v4 -mavxvnni -mavx512vnni -mavx512bf16 -mavx512vbmi'
